# ==============================================================================
# GI Helper environment configuration (everything here is optional)
# ==============================================================================
# AI Vision API keys are NOT read from the server environment: each visitor
# enters their own key in Scanner Settings, where it stays in their browser.
# ==============================================================================

# Public origin of the site, used for canonical URLs, the sitemap, robots.txt
# and Open Graph images (no trailing slash). Only needed for a custom domain;
# when empty it defaults to https://gi-helper.vercel.app.
NEXT_PUBLIC_SITE_URL=""

# ------------------------------------------------------------------------------
# Supabase: feedback (/feedback, /feedback/inbox) and the scan counter.
# See docs/feedback.md. Project URL and its publishable key
# (Project Settings > API Keys). Server-only: don't prefix with NEXT_PUBLIC_.
# Without them the feedback page shows "Feedback is offline" and the scan
# counter is hidden.
# ------------------------------------------------------------------------------
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""
# Shared secret checked by the write functions (feedback_submit,
# feedback_admin_login, scan_record) once enforce_rpc_secret is on. Server-only.
SUPABASE_RPC_SECRET=""
# Optional secret salt for the hashed sender IPs used for rate limits
FEEDBACK_HASH_SALT=""
