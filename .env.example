# ==============================================================================
# Genshin Material Tracker & AI Inventory Scanner Environment Configuration
# ==============================================================================
# NOTE: All keys configured here act as server-side fallbacks.
# If a user enters an API key in the web application UI (under Scanner Settings),
# their browser localStorage key will automatically OVERRIDE these values.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Gemini AI (Recommended - Fast & Free Tier Available)
# Get a key at: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
GEMINI_API_KEY=""

# ------------------------------------------------------------------------------
# 2. OpenAI (GPT-4o & GPT-4o-mini)
# Get a key at: https://platform.openai.com/api-keys
# ------------------------------------------------------------------------------
OPENAI_API_KEY=""

# ------------------------------------------------------------------------------
# 3. Anthropic Claude (Claude 3.5 Sonnet & Haiku)
# Get a key at: https://console.anthropic.com/settings/keys
# ------------------------------------------------------------------------------
ANTHROPIC_API_KEY=""
# Alternative alias:
# CLAUDE_API_KEY=""

# ------------------------------------------------------------------------------
# 4. xAI Grok (Grok 2 Vision)
# Get a key at: https://console.x.ai
# ------------------------------------------------------------------------------
GROK_API_KEY=""
# Alternative alias:
# XAI_API_KEY=""

# ------------------------------------------------------------------------------
# 5. Custom / OpenAI-Compatible Vision API (OpenRouter, Ollama, DeepSeek)
# e.g., https://openrouter.ai/keys
# ------------------------------------------------------------------------------
CUSTOM_AI_API_KEY=""
CUSTOM_AI_MODEL="qwen/qwen-2-vl-72b-instruct"
CUSTOM_AI_BASE_URL="https://openrouter.ai/api/v1"

# ------------------------------------------------------------------------------
# Optional App Settings
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="Genshin Material Tracker"

# Public origin of the site, used for canonical URLs, the sitemap, robots.txt
# and Open Graph images (no trailing slash). Only needed for a custom domain;
# when empty it defaults to https://gi-helper.vercel.app.
NEXT_PUBLIC_SITE_URL=""

# ------------------------------------------------------------------------------
# Feedback page (/feedback) and inbox (/feedback/inbox), see docs/feedback.md
# Supabase project URL and its publishable key (Project Settings > API Keys).
# Server-only: don't prefix with NEXT_PUBLIC_. Without them the page shows
# "Feedback is offline".
# ------------------------------------------------------------------------------
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""
# Optional secret salt for the hashed sender IPs used to rate-limit messages
FEEDBACK_HASH_SALT=""
