# PostgreSQL connection string (Railway provides this automatically when you add a Postgres service)
DATABASE_URL="postgresql://user:password@host:port/database?schema=public"
DIRECT_URL="postgresql://user:password@host:port/database?schema=public"
NEXT_PUBLIC_APP_NAME="Genshin Material Tracker"
SEED_MASTER_PASSWORD='ChangeMe'
# Legacy defaults used only until a user saves their own AI settings in the app.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5-mini"
# Secret used to encrypt per-user AI provider API keys at rest. Optional: if
# unset, a stable key is derived from DATABASE_URL. Set a dedicated value in
# production. Generate one with: openssl rand -hex 32
AI_SETTINGS_SECRET=""
