{
  "name": "genshin-material-tracker",
  "version": "0.0.21",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:webpack": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "npx tsx --test tests/**/*.test.ts",
    "test:e2e": "playwright test",
    "test:grid-detector": "npx tsx --test tests/grid-detector.test.ts tests/grid-detector-samples.test.ts",
    "eval:grid-detector": "tsx scripts/evaluate-grid-detector.ts",
    "test:material-detector": "npx tsx --test tests/material-detector.test.ts tests/material-detector-samples.test.ts",
    "eval:material-detector": "tsx scripts/evaluate-material-detector.ts",
    "build:material-atlas": "tsx scripts/build-material-atlas.ts",
    "build:digit-templates": "tsx scripts/build-digit-templates.ts",
    "build:material-thumbs": "tsx scripts/build-material-thumbs.ts",
    "build:brand-icons": "tsx scripts/build-brand-icons.ts",
    "scrape:characters": "tsx scripts/scrape-characters.ts",
    "scrape:weapons": "tsx scripts/scrape-weapons.ts",
    "scrape:artifacts": "tsx scripts/scrape-artifacts.ts",
    "scrape:other-materials": "tsx scripts/scrape-other-materials.ts",
    "sync-data": "tsx scripts/scrape-materials.ts && tsx scripts/update-families.ts && tsx scripts/build-material-atlas.ts && tsx scripts/build-material-thumbs.ts && tsx scripts/scrape-characters.ts && tsx scripts/scrape-weapons.ts && tsx scripts/scrape-artifacts.ts && tsx scripts/scrape-other-materials.ts",
    "feedback:admin": "tsx scripts/feedback-admin.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  },
  "dependencies": {
    "@supabase/realtime-js": "^2.117.3",
    "@vercel/analytics": "^2.0.1",
    "bad-words": "^4.1.5",
    "clsx": "^2.1.1",
    "lucide-react": "^0.510.0",
    "next": "^15.5.27",
    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.90.0",
    "react-markdown": "^10.1.0",
    "react-select": "^5.10.2",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "bcryptjs": "^3.0.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.27",
    "genshin-db": "^5.2.14",
    "jimp": "^1.6.1",
    "playwright": "^1.64.0",
    "postcss": "^8.5.30",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
