{
  "name": "genshin-material-tracker",
  "version": "0.0.49",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "predev": "node scripts/sync-sw-version.mjs",
    "dev:webpack": "next dev",
    "build": "next build",
    "prebuild": "node scripts/sync-sw-version.mjs",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "pnpm --dir ../gi-tests test",
    "test:e2e": "pnpm --dir ../gi-tests test:e2e",
    "sync-data": "pnpm --dir ../gi-sync-catalogue sync-data && pnpm --dir ../gi-sync-catalogue export:app",
    "feedback:admin": "tsx scripts/feedback-admin.ts",
    "postinstall": "node scripts/copy-ocr-assets.mjs && node scripts/sync-sw-version.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  },
  "dependencies": {
    "@gi/detection-core": "workspace:*",
    "@gi/grid-detector": "workspace:*",
    "@gi/image-scanner": "workspace:*",
    "@gi/artifact-panel": "workspace:*",
    "@gi/video-scanner": "workspace:*",
    "@gi/scanner": "workspace:*",
    "@gi/good": "workspace:*",
    "@supabase/realtime-js": "^2.117.3",
    "@tesseract.js-data/chi_sim": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@vercel/analytics": "^2.0.1",
    "bad-words": "^4.1.5",
    "lucide-react": "^0.510.0",
    "next": "^15.5.27",
    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.8",
    "tesseract.js": "7.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "bcryptjs": "^3.0.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.27",
    "postcss": "^8.5.30",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
