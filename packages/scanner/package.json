{
  "name": "@gi/scanner",
  "version": "0.0.1",
  "private": true,
  "description": "Unified scanner engine and orchestrator for GI Helper",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts",
    "./types": "./src/types/index.ts",
    "./types/*": "./src/types/*.ts",
    "./constants": "./src/constants/index.ts",
    "./constants/*": "./src/constants/*.ts",
    "./equipment": "./src/equipment.ts",
    "./inventory": "./src/inventory.ts",
    "./settings": "./src/settings.ts",
    "./engine/*": "./src/engine/*.ts"
  },
  "dependencies": {
    "@gi/detection-core": "workspace:*",
    "@gi/grid-detector": "workspace:*",
    "@gi/image-scanner": "workspace:*",
    "@gi/artifact-panel": "workspace:*",
    "@gi/good": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
