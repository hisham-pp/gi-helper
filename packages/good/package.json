{
  "name": "@gi/good",
  "version": "0.0.1",
  "private": true,
  "description": "Genshin Open Object Description (GOOD) format library and inventory stores",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts",
    "./types": "./src/types/index.ts",
    "./types/*": "./src/types/*.ts",
    "./catalog": "./src/catalog.ts",
    "./inventory": "./src/inventory.ts",
    "./export": "./src/export.ts",
    "./import": "./src/import.ts"
  },
  "dependencies": {
    "@gi/detection-core": "workspace:*",
    "@gi/scanner": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
