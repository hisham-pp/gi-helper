generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Material {
  id                        String                           @id
  name                      String                           @unique
  image                     String
  rarity                    Int
  category                  String
  description               String
  combinable                Boolean                          @default(false)
  combineRatio              Int?
  parentMaterialId          String?
  createdAt                 DateTime                         @default(now())
  updatedAt                 DateTime                         @updatedAt
  inventories               Inventory[]
  parentMaterial            Material?                        @relation("MaterialTree", fields: [parentMaterialId], references: [id], onDelete: SetNull)
  childMaterials            Material[]                       @relation("MaterialTree")
  goalMaterials             GoalMaterial[]
  characterTemplateMaterials CharacterGoalTemplateMaterial[] @relation("CharacterTemplateMaterials")
  weaponTemplateMaterials    WeaponGoalTemplateMaterial[]    @relation("WeaponTemplateMaterials")

  @@index([category])
  @@index([parentMaterialId])
  @@map("materials")
}

model User {
  id           String      @id @default(cuid())
  username     String      @unique
  passwordHash String
  role         String      @default("user")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  sessions     Session[]
  inventory    Inventory[]
  goals        Goal[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Inventory {
  id         String   @id @default(cuid())
  userId     String
  materialId String
  quantity   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, materialId])
  @@index([materialId])
  @@map("inventory")
}

model Goal {
  id            String         @id @default(cuid())
  userId        String
  name          String
  description   String?
  templateType  String?
  templateId    String?
  completed     Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  goalMaterials GoalMaterial[]
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([templateType, templateId])
  @@map("goals")
}

model GoalMaterial {
  id         String   @id @default(cuid())
  goalId     String
  materialId String
  required   Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  goal       Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([goalId, materialId])
  @@index([materialId])
  @@map("goal_materials")
}

model Character {
  id          String                    @id
  name        String
  image       String
  rarity      Int
  element     String
  weaponType  String
  region      String
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
  templates   CharacterGoalTemplate[]

  @@index([rarity])
  @@index([element])
  @@map("characters")
}

model Weapon {
  id          String                 @id
  name        String                 @unique
  image       String
  rarity      Int
  weaponType  String
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  templates   WeaponGoalTemplate[]

  @@index([rarity])
  @@index([weaponType])
  @@map("weapons")
}

model CharacterGoalTemplate {
  id                  String                           @id @default(cuid())
  characterId         String
  name                String
  description         String?
  category            String
  sortOrder           Int                              @default(0)
  createdAt           DateTime                         @default(now())
  updatedAt           DateTime                         @updatedAt
  character           Character                        @relation(fields: [characterId], references: [id], onDelete: Cascade)
  materials           CharacterGoalTemplateMaterial[]

  @@index([characterId])
  @@index([category])
  @@map("character_goal_templates")
}

model CharacterGoalTemplateMaterial {
  id         String                @id @default(cuid())
  templateId String
  materialId String
  required   Int
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
  template   CharacterGoalTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  material   Material              @relation("CharacterTemplateMaterials", fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([templateId, materialId])
  @@index([materialId])
  @@map("character_goal_template_materials")
}

model WeaponGoalTemplate {
  id                  String                        @id @default(cuid())
  weaponId            String
  name                String
  description         String?
  category            String
  sortOrder           Int                           @default(0)
  createdAt           DateTime                      @default(now())
  updatedAt           DateTime                      @updatedAt
  weapon              Weapon                        @relation(fields: [weaponId], references: [id], onDelete: Cascade)
  materials           WeaponGoalTemplateMaterial[]

  @@index([weaponId])
  @@index([category])
  @@map("weapon_goal_templates")
}

model WeaponGoalTemplateMaterial {
  id         String             @id @default(cuid())
  templateId String
  materialId String
  required   Int
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  template   WeaponGoalTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  material   Material           @relation("WeaponTemplateMaterials", fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([templateId, materialId])
  @@index([materialId])
  @@map("weapon_goal_template_materials")
}
