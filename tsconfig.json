{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@gi/detection-core": ["./packages/detection-core/src/index.ts"],
      "@gi/detection-core/*": ["./packages/detection-core/src/*"],
      "@gi/grid-detector": ["./packages/grid-detector/src/index.ts"],
      "@gi/grid-detector/*": ["./packages/grid-detector/src/*"],
      "@gi/image-scanner": ["./packages/image-scanner/src/index.ts"],
      "@gi/image-scanner/*": ["./packages/image-scanner/src/*"],
      "@gi/material-detector": ["./packages/image-scanner/src/index.ts"],
      "@gi/material-detector/*": ["./packages/image-scanner/src/*"],
      "@gi/artifact-panel": ["./packages/artifact-panel/src/index.ts"],
      "@gi/artifact-panel/*": ["./packages/artifact-panel/src/*"],
      "@gi/video-scanner": ["./packages/video-scanner/src/index.ts"],
      "@gi/video-scanner/*": ["./packages/video-scanner/src/*"],
      "@gi/scanner": ["./packages/scanner/src/index.ts"],
      "@gi/scanner/*": ["./packages/scanner/src/*"],
      "@gi/good": ["./packages/good/src/index.ts"],
      "@gi/good/*": ["./packages/good/src/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next-prod/types/**/*.ts",
    ".next-turbo/types/**/*.ts",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    "tmp/.next-panel/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "scripts",
    "tests"
  ]
}
